# ============================================================
# HedefMatik.com - Hostinger Apache / LiteSpeed SPA Rewrite Rule
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /api ve /uploads isteklerini yerel FastAPI backend gateway'e yönlendir (Ultra-fast PHP Proxy)
  RewriteRule ^api/(.*)$ api_gateway.php [QSA,L]
  RewriteRule ^uploads/(.*)$ api_gateway.php [QSA,L]

  # HTTPS Yönlendirmesi (SSL Zorunlu)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Eğer dosya veya dizin fiziksel olarak mevcutsa doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Diğer tüm sayfa isteklerini React SPA index.html'e yönlendir (404 hatasını önler)
  RewriteRule ^ index.html [L]
</IfModule>

# Güvenlik & Önbellekleme Başlıkları
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  # HTML dosyaları için önbelleği devre dışı bırak (yeni derlemelerin anında yüklenmesi için)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Parmak izli (hash'li) statik varlıklar için uzun süreli önbellekleme
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
