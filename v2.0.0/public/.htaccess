# ============================================================
# HedefMatik.com - Hostinger Apache / LiteSpeed SPA Rewrite Rule
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS Yönlendirmesi (SSL Zorunlu)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Eğer dosya veya dizin fiziksel olarak mevcutsa doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /api ve /uploads istekleri backend proxy için (eğer aynı domain üzerinde yönlendiriliyorsa)
  # RewriteRule ^api/(.*)$ http://127.0.0.1:8001/api/$1 [P,L]

  # Diğer tüm sayfa isteklerini React SPA index.html'e yönlendir (404 hatasını önler)
  RewriteRule ^ index.html [L]
</IfModule>

# Güvenlik & Önbellekleme Başlıkları
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  # Static asset caching
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
